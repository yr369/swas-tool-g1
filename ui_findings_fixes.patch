+    }
+
+    mainEl.addEventListener("scroll", onScroll, { passive: true });
+    mainEl.scrollTop = scrollPositions.current.get(location.key) || 0;
+
+    return () => mainEl.removeEventListener("scroll", onScroll);
+  }, [location.key]);
